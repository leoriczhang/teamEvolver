{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@memory/*": ["../team_memory/frontend/*"],
      "@miner/*": ["../team_miner/frontend/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "react-markdown": ["./node_modules/react-markdown"],
      "remark-gfm": ["./node_modules/remark-gfm"],
      "@testing-library/*": ["./node_modules/@testing-library/*"],
      "vitest": ["./node_modules/vitest"]
    },
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "../team_memory/frontend", "../team_miner/frontend"],
  "references": []
}
