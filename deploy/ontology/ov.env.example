# Historical V5 example. Superseded by docs/zh/guides/20-kee-r6.md.
# KEE R6 does not install OV Ontology routes, tables or workers; configure OV's
# existing content/ACL/index services instead. These variables cannot enable R6.
# Do not delete historical tables or rotate observation secrets during migration.
OV_ONTOLOGY_ENABLED=0
# Optional override; unset/empty reuses OV storage.vectordb.pgvector.
# If no pgvector backend is active, reuses enabled metadata PostgreSQL.
# OV_ONTOLOGY_PG_DSN=postgresql://ontology_assets:REPLACE@postgres:5432/ov_assets
# Observation handles only. Publication uses native trusted + Root Key.
OV_ONTOLOGY_SIGNING_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Native Compile keeps its own original metadata configuration. No equality requirement.
# No OV Runtime URL or model credentials are needed for ontology builds.
# Configure server.auth_mode=trusted and server.root_api_key in OV config.
# TE sharing.viking_api_key must hold that same backend Root Key.
