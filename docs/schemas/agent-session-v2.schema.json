{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamevolver.local/schemas/agent-session-v2.schema.json",
  "title": "teamEvolver Agent Session V2",
  "type": "object",
  "required": ["schema_version", "protocol_version", "session_id", "runtime", "runtime_context", "turns"],
  "properties": {
    "schema_version": {"const": "teamevolver.agent-session.v2"},
    "protocol_version": {"type": "string", "pattern": "^2\\."},
    "session_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object", "required": ["type"],
      "properties": {"type": {"type": "string", "minLength": 1}, "version": {"type": ["string", "number"]}}
    },
    "runtime_context": {
      "type": "object", "required": ["user_id"],
      "properties": {"user_id": {"type": "string", "minLength": 1, "maxLength": 160}}
    },
    "turns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "context_usage": {
            "type": "object",
            "properties": {
              "context_snapshot_id": {"type": "string"},
              "memory_refs": {"type": "array", "items": {"type": "object"}},
              "skill_refs": {"type": "array", "items": {"type": "object"}},
              "feedback": {"type": "object"}
            }
          }
        }
      }
    },
    "metrics": {"type": "object"},
    "source_materials": {"type": "array", "items": {"type": "object"}}
  }
}
