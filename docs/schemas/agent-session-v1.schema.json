{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamevolver.local/schemas/agent-session-v1.schema.json",
  "title": "teamEvolver Agent Session V1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "session_id",
    "runtime",
    "runtime_context",
    "turns"
  ],
  "properties": {
    "schema_version": {
      "const": "teamevolver.agent-session.v1"
    },
    "protocol_version": {
      "pattern": "^1\\."
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "required": [
        "type",
        "integration_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "integration_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "number"
          ]
        },
        "protocol_version": {
          "pattern": "^1\\."
        }
      },
      "additionalProperties": true
    },
    "runtime_context": {
      "type": "object"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "turn_num"
        ],
        "properties": {
          "turn_num": {
            "type": "integer",
            "minimum": 1
          },
          "context_usage": {
            "type": "object",
            "properties": {
              "context_snapshot_id": {
                "type": "string"
              },
              "memory_refs": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "skill_refs": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "feedback": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object"
    },
    "source_materials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
