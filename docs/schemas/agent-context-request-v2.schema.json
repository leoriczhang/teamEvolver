{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamevolver.local/schemas/agent-context-request-v2.schema.json",
  "title": "teamEvolver Context Resolve Request V2",
  "type": "object",
  "required": ["user_id", "query"],
  "properties": {
    "user_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "context_session_id": {"type": "string"},
    "scopes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["personal_memory", "team_memory", "personal_skills", "team_skills", "personal_resources", "team_resources"]}
    },
    "max_items": {"type": "integer", "minimum": 1, "maximum": 50},
    "max_chars": {"type": "integer", "minimum": 500, "maximum": 100000}
  },
  "additionalProperties": true
}
