# teamEvolver 环境变量模板
# 用法：cp .env.example .env（本地开发；.env 被 .gitignore 忽略）。
# run_local.sh 加载 .env；容器部署将环境文件挂载到 /app/deploy/.env。

# --- LLM ---------------------------------------------------------------
TEAMEVOLVER_LLM_BASE_URL=https://api.openai.com/v1
TEAMEVOLVER_LLM_MODEL=gpt-4o-mini
TEAMEVOLVER_LLM_API_KEY="your-model-api-key"

# --- OpenViking -----------------------------------------------------------
TEAMEVOLVER_OV_ENDPOINT=http://127.0.0.1:1933
# OpenViking Root Key，仅在服务端使用。
TEAMEVOLVER_OV_API_KEY="your-ov-api-key"
# 可显式指定环境文件的绝对路径：
# TEAMEVOLVER_ENV_FILE=/absolute/path/to/.env

# --- PostgreSQL（teamEvolver 专用实例）------------------------------------
# storage_pg_dsn 留空时用以下分字段自动拼装 DSN。
# 密码无需 URL 编码：#/@/: 等特殊字符会自动 percent-encode。
TEAMEVOLVER_PG_HOST=127.0.0.1
TEAMEVOLVER_PG_PORT=5432
TEAMEVOLVER_PG_DATABASE=teamevolver
TEAMEVOLVER_PG_USERNAME=teamevolver
TEAMEVOLVER_PG_PASSWORD="your-password"

# --- 服务认证 -----------------------------------------------------------
# teamEvolver 服务 Root Key。首次管理员初始化：/api/auth/bootstrap。
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
TEAMEVOLVER_ROOT_API_KEY="your-root-key"
# 用于 Secret Ref 加密；未设置时使用服务 Root Key，投入使用后保持稳定。
# TEAMEVOLVER_SECRET_MASTER_KEY="your-secret-master-key"

# --- default 租户的 Agent 机器凭证 ----------------------------------------
# 其他租户使用控制台「租户管理」签发的租户 Key。
# 必须以 tevt_ 开头，服务端将其解析为 default 租户；轮换 = 改值并重启进程。
# 生成：TEAMEVOLVER_TENANT_TOKEN="tevt_$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
#TEAMEVOLVER_TENANT_TOKEN="tevt_your-tenant-machine-credential"

# --- Apache Doris 数据源（可选）-------------------------------------------
# 表需要提供 Langfuse 格式的 trace 和 observation 字段。
DORIS_HOSTS=doris.example.com
DORIS_PORT=9030
DORIS_DB=traces
DORIS_USER=your-doris-user
DORIS_PASSWORD="your-doris-password"
DORIS_TRACES_TABLE=langfuse_traces
DORIS_OBSERVATIONS_TABLE=langfuse_observations
DORIS_MAPPING_TABLE=langfuse_project_id_mapping
# 直连需安装 pymysql；可显式配置 HTTP 查询代理，默认校验 TLS。
DORIS_FORCE_PROXY=0
DORIS_PROXY_URL=
# DORIS_CA_BUNDLE=/absolute/path/to/ca.pem

# --- Langfuse 直连拉取（可选，provider "langfuse" 的租户 adapter）-----------
# 与 self-tracing 的 LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY 刻意区分（拉取源 ≠ 上报目标）。
# 密钥为项目级；每个项目使用独立的拉取凭证。
LANGFUSE_PULL_HOST=https://langfuse.example.com
LANGFUSE_PULL_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_PULL_SECRET_KEY="your-langfuse-secret-key"
