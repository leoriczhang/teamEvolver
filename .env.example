# teamEvolver 环境变量模板
# 用法：cp .env.example .env（本地开发；.env 被 .gitignore 忽略）。
# .env_sit / .env_prd 为部署环境文件（已入库，随 config_sit/prd.yaml 配套维护）。
# run_local.sh 自动加载 .env；SIT/PRD 部署将 .env_sit / .env_prd 挂载为
# /app/deploy/.env（同 OpenViking），container_start.sh 加载后做必填校验。

# --- LLM（必须与 config 中的 api_base / model_id 配套）--------------------
TEAMEVOLVER_LLM_API_KEY="your-model-gateway-key"

# --- OpenViking -----------------------------------------------------------
# 通用客户端凭证 -> sharing.viking_api_key
TEAMEVOLVER_OV_API_KEY="your-ov-api-key"
# 历史变量名：团队服务凭证 -> sharing.viking_team_api_key
TEAMEVOLVER_OV_ROOT_KEY="your-ov-team-service-key"
# 本地读取 config/config_sit.yaml 等文件时，显式指定对应环境文件的绝对路径：
# TEAMEVOLVER_ENV_FILE=/absolute/path/to/.env_sit

# --- PostgreSQL（teamEvolver 专用实例）------------------------------------
# storage_pg.dsn 留空时，dsn_from_env() 用以下分字段自动拼装 DSN。
# 密码无需 URL 编码：#/@/: 等特殊字符会自动 percent-encode。
TEAMEVOLVER_PG_HOST=your-pg-host
TEAMEVOLVER_PG_PORT=5432
TEAMEVOLVER_PG_DATABASE=teamevolver
TEAMEVOLVER_PG_USERNAME=teamevolver
TEAMEVOLVER_PG_PASSWORD="your-password"

# --- 服务认证（storage_pg.enabled 时必填）----------------------------------
# /v1/ API 与首次 admin 引导（/api/auth/bootstrap）的 Bearer root key
# （同 OpenViking 的 OV_ROOT_API_KEY）。生成：python3 -c "import secrets; print(secrets.token_hex(32))"
TEAMEVOLVER_ROOT_API_KEY="your-root-key"

# --- 单租户部署的 Agent 机器凭证（storage_pg 未启用时可选）-------------------
# Agent 数据面唯一的机器凭证：仅在单租户部署（未启用 storage_pg，多租户控制台不签发凭证）时
# 通过此变量配置；多租户部署请改用控制台「租户管理」创建租户时签发的凭证。
# 必须以 tevt_ 开头，服务端将其解析为 default 租户；轮换 = 改值并重启进程。
# 生成：TEAMEVOLVER_TENANT_TOKEN="tevt_$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
#TEAMEVOLVER_TENANT_TOKEN="tevt_your-tenant-machine-credential"

# --- Doris（agent trace 数据源）---------------------------------------------
# 统一走 Doris 拉取 Langfuse 格式的 trace 数据（见 session_ingestion/adapters/sources/doris.py）。
# agent 只需 project_id + 帐号密码即可跑。
DORIS_HOSTS=agents-1-prd-doris.bdp.sfcloud.local,agents-2-prd-doris.bdp.sfcloud.local,agents-3-prd-doris.bdp.sfcloud.local
DORIS_PORT=9030
DORIS_DB=ai_agent
DORIS_USER=aiagent_ljk
DORIS_PASSWORD="your-doris-password"
# 本地开发无法直连内网 FE 时设 1，强制走 HTTP 代理；生产内网部署可设 0 恢复直连优先。
DORIS_FORCE_PROXY=1
DORIS_PROXY_URL=https://skill-opt.sf-express.com/api/doris/query

# --- Langfuse 直连拉取（可选，provider "langfuse" 的租户 adapter）-----------
# 与 self-tracing 的 LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY 刻意区分（拉取源 ≠ 上报目标）。
# 密钥为项目级：SIT 见 .env_sit（产品设计项目试点）；PRD 待补。留空则 langfuse
# adapter 报"未配置"，不影响 Doris 链路。
LANGFUSE_PULL_HOST=https://ai-langfuse.sit.sf-express.com
LANGFUSE_PULL_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_PULL_SECRET_KEY="your-langfuse-secret-key"

# TE 内置 Ontology；只在完成TE/OV PostgreSQL、OV trusted + Root Key 和租户授权后启用。
TE_ONTOLOGY_ENABLED=0
# 模型沿用 TEAMEVOLVER_LLM_API_KEY，不配置独立 Runtime 或另一套模型密钥。
