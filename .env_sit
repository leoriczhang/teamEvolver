# teamEvolver SIT 部署环境变量
# 用途：部署平台将本文件内容挂载为 /app/deploy/.env（或粘贴到平台环境变量配置，
#       对应 container_start.sh 的 PG 必填校验）。本文件入库，与 config_sit.yaml 配套。
# 本地直接读取该配置时显式设置 TEAMEVOLVER_ENV_FILE 为本文件的绝对路径。
# 仅更新仓库文件不会刷新运行实例；部署需同步挂载文件并重启服务。

# --- LLM（Skill Evolution / True Replay 共用）------------------------------
# 与 config/config_sit.yaml 的模型网关配套；平台变量可覆盖本文件。
TEAMEVOLVER_LLM_API_KEY=

# --- PostgreSQL（teamEvolver 专用实例，SIT）--------------------------------
TEAMEVOLVER_PG_HOST=teamevolver-pgm.dbsit.sfcloud.local
TEAMEVOLVER_PG_PORT=5660
TEAMEVOLVER_PG_DATABASE=teamevolver
TEAMEVOLVER_PG_USERNAME=teamevolver
TEAMEVOLVER_PG_PASSWORD=

# --- 服务认证 ---------------------------------------------------------------
# storage_pg.enabled 时 /v1/ API 与首次 admin 引导（/api/auth/bootstrap）必填：
# 请求方以 Authorization: Bearer <key> 携带（同 OpenViking 的 OV_ROOT_API_KEY）。
TEAMEVOLVER_ROOT_API_KEY=

# --- OpenViking（SIT）-------------------------------------------------------
# 当前 trusted 部署沿用该环境既有 Root Key，分别注入通用和团队客户端。
# OV_API_KEY -> sharing.viking_api_key；OV_ROOT_KEY -> sharing.viking_team_api_key（历史命名）。
# 两项均需注入；后续改用独立服务 Key 时同步更新相应字段。
TEAMEVOLVER_OV_API_KEY=
TEAMEVOLVER_OV_ROOT_KEY=

# --- OpenViking（SIT，trusted 模式）----------------------------------------
# SIT OpenViking root key（openviking.intsit.sfcloud.local:1080，auth_mode=trusted，
# 每个请求必带）。注入 sharing.viking_team_api_key，供 viking 共享后端/技能同步使用。
TEAMEVOLVER_OV_ROOT_KEY=

# --- Doris（agent trace 数据源，SIT）----------------------------------------
# 统一走 Doris 拉取 Langfuse 格式的 trace 数据。
# agent 只需 project_id + 帐号密码即可跑（见 session_ingestion/adapters/sources/doris.py）。
DORIS_HOSTS=agents-1-prd-doris.bdp.sfcloud.local,agents-2-prd-doris.bdp.sfcloud.local,agents-3-prd-doris.bdp.sfcloud.local
DORIS_PORT=9030
DORIS_DB=ai_agent
DORIS_USER=aiagent_ljk
DORIS_PASSWORD=
# 本地开发无法直连内网 FE 时设 1，强制走 HTTP 代理；生产内网部署可设 0 恢复直连优先。
DORIS_FORCE_PROXY=1
DORIS_PROXY_URL=https://skill-opt.sf-express.com/api/doris/query

# --- Langfuse 直连拉取（provider "langfuse" 的租户 adapter）----------------
# 与 self-tracing 的 LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY 刻意区分（拉取源 ≠ 上报目标）。
# 密钥为项目级（Basic 认证即项目范围）：当前三元组对应产品设计项目
# cmov8jh43015yxa06g4nu4xfd（SIT）。其他项目在租户 adapter 文件里用 options 覆盖。
LANGFUSE_PULL_HOST=https://ai-langfuse.sit.sf-express.com
LANGFUSE_PULL_PUBLIC_KEY=
LANGFUSE_PULL_SECRET_KEY=

# TE 内置 Ontology 已启用；部署需具备 TE/OV PostgreSQL、OV trusted + Root Key 和租户授权。
TE_ONTOLOGY_ENABLED=1
# 模型沿用 TEAMEVOLVER_LLM_API_KEY，不配置独立 Runtime 或另一套模型密钥。

# 服务日志（加载到进程环境后覆盖 YAML；同步部署挂载文件并重启生效）
TEAMEVOLVER_LOG_LEVEL=INFO
TEAMEVOLVER_LOG_DIR=/app/deploy/logs
TEAMEVOLVER_LOG_FILE_ENABLED=1
TEAMEVOLVER_LOG_CONSOLE_ENABLED=1
TEAMEVOLVER_LOG_MAX_FILE_MB=100
TEAMEVOLVER_LOG_RETENTION_DAYS=14
TEAMEVOLVER_LOG_MAX_TOTAL_MB=2048
# 同目录多实例必须开启隔离，使用稳定、唯一的实例标识分目录。
# TEAMEVOLVER_MULTI_REPLICA=1
# TEAMEVOLVER_INSTANCE_ID=te-sit
