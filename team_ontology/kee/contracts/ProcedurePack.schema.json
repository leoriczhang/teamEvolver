{
  "$defs": {
    "CapabilityBinding": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "kee.capability-binding.v1",
          "default": "kee.capability-binding.v1",
          "title": "Contract",
          "type": "string"
        },
        "skill_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "object"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "version",
        "description"
      ],
      "title": "CapabilityBinding",
      "type": "object"
    },
    "CaseEvidence": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "kee.case-evidence.v1",
          "default": "kee.case-evidence.v1",
          "title": "Contract",
          "type": "string"
        },
        "kind": {
          "enum": [
            "Evidence",
            "Session",
            "receipt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "outcome": {
          "default": "unknown",
          "enum": [
            "supported",
            "contradicted",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "CaseEvidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "polarity": {
          "default": "positive",
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "subject",
        "predicate",
        "value",
        "evidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
          "title": "Method Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Conditions",
          "type": "array"
        },
        "prohibitions": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Prohibitions",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Exceptions",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "completion": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Completion",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityBinding"
          },
          "maxItems": 50,
          "title": "Capabilities",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CaseEvidence"
          },
          "maxItems": 100,
          "title": "Cases",
          "type": "array"
        },
        "related_methods": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Related Methods",
          "type": "array"
        }
      },
      "required": [
        "method_id",
        "title",
        "purpose",
        "steps",
        "completion",
        "evidence"
      ],
      "title": "Method",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "uri": {
          "default": "",
          "title": "Uri",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "digest",
        "start",
        "end",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "kee.procedure-pack.v1",
      "default": "kee.procedure-pack.v1",
      "title": "Contract",
      "type": "string"
    },
    "pack_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
      "title": "Pack Id",
      "type": "string"
    },
    "version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "schema_revision": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Schema Revision",
      "type": "string"
    },
    "schema_body": {
      "additionalProperties": true,
      "title": "Schema Body",
      "type": "object"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/Method"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 10000,
      "title": "Facts",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "pack_id",
    "version",
    "schema_revision",
    "methods"
  ],
  "title": "ProcedurePack",
  "type": "object"
}
