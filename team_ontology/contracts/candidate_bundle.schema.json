{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "polarity": {
          "default": "positive",
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Qualifiers",
          "type": "object"
        },
        "epistemic_kind": {
          "default": "document_fact",
          "enum": [
            "document_fact",
            "user_claim",
            "system_fact",
            "derived"
          ],
          "title": "Epistemic Kind",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "support_sets": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Support Sets",
          "type": "array"
        },
        "premises": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Premises",
          "type": "array"
        }
      },
      "required": [
        "assertion_id",
        "subject",
        "predicate",
        "value",
        "valid_from",
        "support_sets"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "authority_namespace": {
          "title": "Authority Namespace",
          "type": "string"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "authority_namespace",
        "entity_type",
        "external_id",
        "label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "revision",
        "digest",
        "start",
        "end",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "sf.ontology.v1",
      "default": "sf.ontology.v1",
      "title": "Contract",
      "type": "string"
    },
    "manifest_digest": {
      "title": "Manifest Digest",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "maxItems": 10000,
      "title": "Entities",
      "type": "array"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "maxItems": 10000,
      "title": "Assertions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20000,
      "title": "Evidence",
      "type": "array"
    },
    "tombstones": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Tombstones",
      "type": "array"
    },
    "schema_proposals": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 100,
      "title": "Schema Proposals",
      "type": "array"
    },
    "extraction": {
      "additionalProperties": true,
      "default": {},
      "title": "Extraction",
      "type": "object"
    }
  },
  "required": [
    "manifest_digest",
    "entities",
    "assertions",
    "evidence"
  ],
  "title": "CandidateBundle",
  "type": "object"
}
