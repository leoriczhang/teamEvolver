{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "digest"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "sf.ontology.v1",
      "default": "sf.ontology.v1",
      "title": "Contract",
      "type": "string"
    },
    "profile": {
      "const": "sf-ontology-build.v1",
      "default": "sf-ontology-build.v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_revision": {
      "title": "Schema Revision",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "expected_generation": {
      "minimum": 0,
      "title": "Expected Generation",
      "type": "integer"
    },
    "mode": {
      "default": "delta",
      "enum": [
        "delta",
        "replace"
      ],
      "title": "Mode",
      "type": "string"
    },
    "extractor": {
      "default": "llm",
      "enum": [
        "fixture",
        "llm"
      ],
      "title": "Extractor",
      "type": "string"
    },
    "deadline_seconds": {
      "default": 120,
      "maximum": 600,
      "minimum": 10,
      "title": "Deadline Seconds",
      "type": "integer"
    },
    "max_assertions": {
      "default": 200,
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Assertions",
      "type": "integer"
    }
  },
  "required": [
    "schema_revision",
    "sources",
    "expected_generation"
  ],
  "title": "Manifest",
  "type": "object"
}
