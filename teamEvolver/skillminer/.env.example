# Configure the provider used by the project-isolated Hermes runtime.
# Do not commit a real .env file.
ARK_API_KEY=your-api-key

# Optional external LIFT checkout/runtime. scripts/setup_lift.sh uses
# external/LIFT by default; override these when LIFT lives elsewhere or uses a
# dedicated Python 3.12 environment.
TEAMEVOLVER_LIFT_ROOT=/absolute/path/to/LIFT
TEAMEVOLVER_LIFT_PYTHON=/absolute/path/to/lift-python
