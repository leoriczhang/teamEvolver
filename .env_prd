# teamEvolver PRD 部署环境变量
# 用途：部署平台将本文件内容挂载为 /app/deploy/.env（或粘贴到平台环境变量配置，
#       对应 container_start.sh 的必填校验）。本文件入库，与 config_prd.yaml 配套。

# --- PostgreSQL（teamEvolver 专用实例，PRD）--------------------------------
TEAMEVOLVER_PG_HOST=teamevolver-pgm.db.sfcloud.local
TEAMEVOLVER_PG_PORT=5660
TEAMEVOLVER_PG_DATABASE=teamevolver
TEAMEVOLVER_PG_USERNAME=teamevolver
TEAMEVOLVER_PG_PASSWORD=""

# --- 服务认证 ---------------------------------------------------------------
# storage_pg.enabled 时 /v1/ API 与首次 admin 引导（/api/auth/bootstrap）必填：
# 请求方以 Authorization: Bearer <key> 携带；这是 TE 服务 Key，不等同于 OV Root Key。
TEAMEVOLVER_ROOT_API_KEY=""

# --- Doris（agent trace 数据源，PRD）----------------------------------------
# 统一走 Doris 拉取 Langfuse 格式的 trace 数据。
# agent 只需 project_id + 帐号密码即可跑（见 session_ingestion/adapters/sources/doris.py）。
DORIS_HOSTS=agents-1-prd-doris.bdp.sfcloud.local,agents-2-prd-doris.bdp.sfcloud.local,agents-3-prd-doris.bdp.sfcloud.local
DORIS_PORT=9030
DORIS_DB=ai_agent
DORIS_USER=aiagent_ljk
DORIS_PASSWORD=""
# 本地开发无法直连内网 FE 时设 1，强制走 HTTP 代理；生产内网部署可设 0 恢复直连优先。
DORIS_FORCE_PROXY=0
DORIS_PROXY_URL=https://skill-opt.sf-express.com/api/doris/query

# --- 页面注册 ---------------------------------------------------------------
# 禁止匿名页面注册；有效服务 Key 鉴权的后端注册仍可使用。
TEAMEVOLVER_SELF_REGISTRATION_ENABLED=false

# --- LLM / OpenViking / Langfuse（由生产部署平台注入）-------------------------
# 以下凭据当前文件未配置；须注入有效生产值。不要使用 SIT 凭据，也不要填字面占位符。
# 进程环境变量优先于挂载文件。本地检查需指定 TEAMEVOLVER_ENV_FILE 的绝对路径。
# TE 的 Skill Evolution / True Replay 使用此模型 Key；Ontology 使用 OV Compile 的模型。
# TEAMEVOLVER_LLM_API_KEY=
# 单一 OpenViking Trusted Root Key -> sharing.viking_api_key
# TEAMEVOLVER_OV_API_KEY=
# config_prd.yaml 已启用追踪，对应生产 Langfuse 凭据：
# TEAMEVOLVER_LANGFUSE_TRACING_PUBLIC_KEY=
# TEAMEVOLVER_LANGFUSE_TRACING_SECRET_KEY=

# --- Ontology ---------------------------------------------------------------
# 与 config_prd.yaml 一致。须先准备 TE PG、生产 OV trusted Root Key、账户 ACL、
# 本体授权及 ontology-extraction-v1 Skill；不需要独立 Runtime 或发布签名密钥。
# 本开关优先于 YAML；任务制品目录由 ontology.state_dir 配置。
TE_ONTOLOGY_ENABLED=1

# --- 全服务文件日志 ---------------------------------------------------------
# 自动创建目录，活动文件 teamEvolver.log；支持按天/大小轮转，写入失败退回平台日志。
# 部署时挂载可写持久目录；文件与控制台同时输出，重启后生效。
TEAMEVOLVER_LOG_LEVEL=INFO
TEAMEVOLVER_LOG_DIR=/app/deploy/logs
TEAMEVOLVER_LOG_FILE_ENABLED=1
TEAMEVOLVER_LOG_CONSOLE_ENABLED=1
TEAMEVOLVER_LOG_MAX_FILE_MB=100
TEAMEVOLVER_LOG_RETENTION_DAYS=14
TEAMEVOLVER_LOG_MAX_TOTAL_MB=2048
# 多副本部署需由平台启用，并将实例标识注入为每个 Pod 的唯一名称。
# TEAMEVOLVER_MULTI_REPLICA=1
# TEAMEVOLVER_INSTANCE_ID=<unique-pod-name>
